# Personal AI Employee Configuration
# Copy this file to .env and fill in your values

# Claude API Configuration (if needed)
CLAUDE_API_KEY=

# Gemini API Configuration
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Gmail IMAP Configuration (use Gmail App Password)

# LinkedIn API Configuration
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# WhatsApp Configuration (if needed)
WHATSAPP_USERNAME=
WHATSAPP_PASSWORD=

# Twitter/X API Configuration
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=
TWITTER_BEARER_TOKEN=

# Facebook/Instagram API Configuration
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# Odoo API Configuration
ODOO_URL=http://localhost:8069
ODOO_DB=personal_ai_employee
ODOO_USERNAME=your_email@gmail.com
ODOO_PASSWORD=admin123

# Facebook/Instagram Configuration
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Filesystem Watcher Configuration
VAULT_PATH=./AI_Employee_Vault
INBOX_FOLDER=Inbox
NEEDS_ACTION_FOLDER=Needs_Action
DONE_FOLDER=Done
LOGS_FOLDER=Logs
PENDING_APPROVAL_FOLDER=Pending_Approval
APPROVED_FOLDER=Approved

# Application Settings
DRY_RUN=false
LOG_LEVEL=INFO


# Optional: PM2 Configuration
PM2_NAME=personal-ai-employee